# Copy this file to .env and fill in your real values.
# Never commit .env to git.

# Port the server listens on (Render/Railway/VPS set this automatically)
PORT=3000

# --- SMTP settings (required for email delivery) ---
# Gmail: host=smtp.gmail.com, port=465, secure=true
#        user = your gmail, pass = an App Password (google.com/apppasswords) — NOT your normal password
# Outlook: host=smtp.office365.com, port=587, secure=false
# Zoho:   host=smtp.zoho.com,      port=465, secure=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password

# Optional: override sender and recipient (defaults to SMTP_USER)
MAIL_FROM=
MAIL_TO=you@gmail.com
